{
  "expo": {
    "name": "AmarHR",
    "slug": "amarhr-app",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amarhr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amarhr.app",
      "infoPlist": {},
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBcgHS3fAT6W_p79_QQZXm9SxKLRCu4uU4"
      },
      "appleTeamId": "2FQYWVB4D9"
    },
    "android": {
      "versionCode": 16,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "package": "mn.amarhr.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDLpCv5-KXGhpED2b-uPrM9M76r4d12QSs"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Цаг бүртгэлд таны байршлыг ашиглана.",
          "locationWhenInUsePermission": "Цаг бүртгэлд таны байршлыг ашиглана."
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9685003-ec99-4a9e-b32d-0b8b9ed0986f"
      }
    },
    "owner": "amarhr",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9685003-ec99-4a9e-b32d-0b8b9ed0986f"
    }
  }
}
